generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  player
  admin
  sub_admin
}

enum KycStatus {
  pending
  verified
  rejected
}

enum TournamentMode {
  solo
  duo
  squad
}

enum TournamentStatus {
  upcoming
  room_released
  live
  completed
  cancelled
}

enum PaymentStatus {
  pending
  success
  failed
  refunded
}

enum TransactionType {
  deposit
  entry_fee
  prize_credit
  withdrawal_hold
  refund
}

enum WithdrawalStatus {
  pending
  approved
  rejected
}

model User {
  id             String   @id @default(uuid())
  supabaseId     String   @unique @map("supabase_id")
  name           String
  phone          String?  @unique
  email          String?  @unique
  ffUid          String?  @map("ff_uid")
  ffIgn          String?  @map("ff_ign")
  walletBalance  Decimal  @default(0) @map("wallet_balance") @db.Decimal(10, 2)
  kycStatus      KycStatus @default(pending) @map("kyc_status")
  role           UserRole  @default(player)
  avatarUrl      String?  @map("avatar_url")
  isActive             Boolean  @default(true) @map("is_active")
  hasClaimedShareBonus Boolean  @default(false) @map("has_claimed_share_bonus")
  referralCode   String?  @unique @map("referral_code")
  referredBy     String?  @map("referred_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  slots               TournamentSlot[]
  walletTransactions  WalletTransaction[]
  withdrawalRequests  WithdrawalRequest[]
  createdTournaments  Tournament[]        @relation("TournamentCreator")
  enteredResults      Result[]            @relation("ResultEnteredBy")
  releasedRooms       Room[]              @relation("RoomReleasedBy")
  approvedWithdrawals WithdrawalRequest[] @relation("WithdrawalApprovedBy")
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@map("users")
}

model Tournament {
  id                String           @id @default(uuid())
  title             String
  mode              TournamentMode
  map               String           @default("Bermuda")
  entryFee          Decimal          @map("entry_fee") @db.Decimal(10, 2)
  prizePool         Decimal          @map("prize_pool") @db.Decimal(10, 2)
  perKillPoint      Int              @default(1) @map("per_kill_point")
  perKillReward     Decimal          @default(0) @map("per_kill_reward") @db.Decimal(10, 2)
  maxSlots          Int              @map("max_slots")
  slotsFilled       Int              @default(0) @map("slots_filled")
  matchDatetime     DateTime         @map("match_datetime")
  status            TournamentStatus @default(upcoming)
  rulesText         String?          @map("rules_text")
  bannerUrl         String?          @map("banner_url")
  // JSON: {"1": 50, "2": 30, "3": 20} — percentage of prize pool
  prizeDistribution Json             @default("{}") @map("prize_distribution")
  // JSON: {"1": 15, "2": 12, "3": 10, "4": 8, "5": 8, "6": 6} — placement points
  pointTable        Json             @default("{}") @map("point_table")
  teamSize          Int              @default(1) @map("team_size")
  createdBy         String           @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  // Relations
  creator  User             @relation("TournamentCreator", fields: [createdBy], references: [id])
  slots    TournamentSlot[]
  rooms    Room[]
  results  Result[]

  @@map("tournaments")
}

model TournamentSlot {
  id            String        @id @default(uuid())
  tournamentId  String        @map("tournament_id")
  slotNumber    Int           @map("slot_number")
  userId        String        @map("user_id")
  // JSON: [{name, ffUid, ffIgn}] for duo/squad teammates
  teamMembers   Json          @default("[]") @map("team_members")
  paymentStatus PaymentStatus @default(pending) @map("payment_status")
  paymentRef    String?       @map("payment_ref")
  joinedAt      DateTime      @default(now()) @map("joined_at")

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  result     Result?

  @@unique([tournamentId, slotNumber])
  @@unique([tournamentId, userId])
  @@map("tournament_slots")
}

model Room {
  id           String   @id @default(uuid())
  tournamentId String   @unique @map("tournament_id")
  roomIdCode   String   @map("room_id_code")
  roomPassword String   @map("room_password")
  releasedAt   DateTime @default(now()) @map("released_at")
  releasedBy   String   @map("released_by")

  // Relations
  tournament Tournament @relation(fields: [tournamentId], references: [id])
  releasedByUser User   @relation("RoomReleasedBy", fields: [releasedBy], references: [id])

  @@map("rooms")
}

model Result {
  id           String   @id @default(uuid())
  tournamentId String   @map("tournament_id")
  slotId       String   @unique @map("slot_id")
  rank         Int
  kills        Int      @default(0)
  pointsEarned Int      @default(0) @map("points_earned")
  prizeWon     Decimal  @default(0) @map("prize_won") @db.Decimal(10, 2)
  enteredBy    String   @map("entered_by")
  enteredAt    DateTime @default(now()) @map("entered_at")

  // Relations
  tournament Tournament     @relation(fields: [tournamentId], references: [id])
  slot       TournamentSlot @relation(fields: [slotId], references: [id])
  enteredByUser User        @relation("ResultEnteredBy", fields: [enteredBy], references: [id])

  @@map("results")
}

model WalletTransaction {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  type        TransactionType
  amount      Decimal         @db.Decimal(10, 2)
  status      PaymentStatus   @default(pending)
  referenceId String?         @map("reference_id")
  description String?
  metadata    Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  amount      Decimal          @db.Decimal(10, 2)
  upiId       String?          @map("upi_id")
  bankDetails Json?            @map("bank_details")
  status      WithdrawalStatus @default(pending)
  reason      String?
  requestedAt DateTime         @default(now()) @map("requested_at")
  processedAt DateTime?        @map("processed_at")
  processedBy String?          @map("processed_by")

  // Relations
  user            User  @relation(fields: [userId], references: [id])
  processedByUser User? @relation("WithdrawalApprovedBy", fields: [processedBy], references: [id])

  @@map("withdrawal_requests")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String
  keys      Json
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@unique([userId, endpoint])
  @@map("push_subscriptions")
}

model Notification {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  message      String
  type         String   @default("info")
  isRead       Boolean  @default(false) @map("is_read")
  tournamentId String?  @map("tournament_id")
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}
